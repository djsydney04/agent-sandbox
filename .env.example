# Copy to .env and edit. Relative workspace paths resolve from this directory.
SANDBOX_WORKSPACE=./workspace
COMPOSE_PROJECT_NAME=codex-egress-sandbox
CODEX_VERSION=0.159.3
SANDBOX_IMAGE_TARGET=base
# For an optional Chromium + Playwright MCP image, use: SANDBOX_IMAGE_TARGET=browser
# Credentials belong in the sandbox's own login volume, not in this file.
